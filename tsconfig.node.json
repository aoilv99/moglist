// このファイルは何をするファイルか:
// Electronのメインプロセス・preloadスクリプト(Node.js側で動くコード)向けの
// TypeScript設定です。`npx tsc --noEmit -p tsconfig.node.json` で型チェックに使われます。
{
  // 型チェックの対象となるファイル(main/preloadと、共有型定義)
  "include": [
    "electron/main/**/*",
    "electron/preload/**/*",
    "electron.vite.config.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["electron-vite/node", "node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    // "@shared/xxx" というインポートを "src/shared/xxx" に解決するための別名設定
    "paths": {
      "@shared/*": ["src/shared/*"]
    },
    // 型チェックのみ行い、JSファイルは出力しない(ビルド自体はelectron-viteが行うため)
    "noEmit": true
  }
}
